# EduMind local configuration
# Copy this file to .env. Never commit or share your .env file.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional provider accepting the OpenAI chat-completions protocol:
# AI_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Local default. Set true only behind an HTTPS reverse proxy.
COOKIE_SECURE=false
PORT=8000
# Optional absolute storage directory. Default: the project's data folder.
# EDUMIND_DATA=C:/EduMind-data
